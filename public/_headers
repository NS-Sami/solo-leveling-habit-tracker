# Response headers for Cloudflare (other hosts ignore this file).

# Always fetch the newest app shell and settings, so updates reach users.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Built files have content hashes in their names, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Basic protection for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
